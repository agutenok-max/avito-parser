# ============================================================
#  Avito Monitor Bot — пример настроек.
#  На хостинге эти значения задаются в разделе «Переменные» (Variables / Secrets).
#  НЕ публикуйте настоящий токен в GitHub!
# ============================================================

# --- Обязательно ---
TELEGRAM_BOT_TOKEN=          # токен от @BotFather
TELEGRAM_ADMIN_ID=           # ваш Telegram ID (бот покажет его после /start). Можно несколько через запятую

# --- Необязательно (значения по умолчанию указаны) ---
CHECK_INTERVAL_MINUTES=3     # интервал проверки (можно менять в боте командой /interval)
MIN_INTERVAL_MINUTES=2       # минимально допустимый интервал
MAX_NOTIFICATIONS_PER_CHECK=10
MAX_PAGES=2                  # смотреть следующие страницы, если на первой все объявления новые
SKIP_OLD_LISTINGS=true       # не присылать давно опубликованные (реклама, «другие города»)
SEND_PHOTOS=true
FETCH_MODE=auto              # auto (HTTP, затем браузер) | http | browser
BLOCK_PAUSE_MINUTES=15       # пауза при ограничении доступа со стороны Avito (дальше удваивается)
BLOCK_PAUSE_MAX_MINUTES=120
MAX_SEARCHES=20
STOP_WORDS=                  # слова в заголовке, объявления с которыми не присылать (через запятую)
PROXY_URL=                   # необязательный HTTP-прокси, например http://user:pass@host:port
TZ=Europe/Moscow
LOG_LEVEL=INFO
DATA_DIR=data                # в Docker — /data (постоянное хранилище)

# --- Старый CLI-парсер (python main.py) ---
TARGET_URL=https://www.avito.ru/moskva/velosipedy?s=104
PARSER_MODE=playwright
USE_ANTIBOT_TRICKS=false
USE_HEADLESS=true
BROWSER_CHANNEL=chromium
USE_LOCAL_HTML=false
LOCAL_HTML_PATH=trash/avito_page.html
